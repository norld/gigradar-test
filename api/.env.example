# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# API Credentials (Required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
OPEN_AI_TOKEN=sk-your_openai_api_key_here

# Notes:
# - TELEGRAM_BOT_TOKEN: Get from @BotFather on Telegram
#   Format: numeric_id:alphanumeric_token
#   Example: xxx
#
# - OPEN_AI_TOKEN: Get from https://platform.openai.com/api-keys
#   Format: sk- followed by alphanumeric string
#   Example: sk-proj-qe9c-VNGM7C...
#
# - LOG_LEVEL: One of debug, info, warn, error (default: info)
#
# - NODE_ENV: One of development, production, test (default: development)
#
# - PORT: Server port (default: 3000)
