{
  "name": "api",
  "version": "1.0.0",
  "description": "Vercel Fastify Serverless API",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "vitest --watch",
    "server:dev": "tsx watch src/server.ts",
    "build": "esbuild index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --external:@vercel/node --external:fastify --external:pino --external:zod",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "keywords": [
    "vercel",
    "fastify",
    "serverless",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@types/node-telegram-bot-api": "^0.64.13",
    "@vercel/node": "^5.5.23",
    "dotenv": "^17.2.3",
    "fastify": "^4.29.1",
    "openai": "^6.16.0",
    "pino": "^8.21.0",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitest/coverage-v8": "^1.6.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "globals": "^14.0.0",
    "msw": "^2.12.7",
    "prettier": "^3.8.0",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.53.0",
    "vitest": "^1.6.1"
  }
}
